# Порт HTTP-сервера. 3000 занят mock-backend фронта, поэтому 3001.
ASPNETCORE_HTTP_PORTS=3001

# Строка подключения к PostgreSQL в формате Npgsql, а не URI: провайдер
# postgres://... не понимает. Двойное подчеркивание - разделитель секций
# конфигурации ASP.NET Core, то есть это ConnectionStrings:Postgres.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=messenger;Username=messenger;Password=messenger
